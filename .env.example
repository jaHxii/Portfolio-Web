# ─── EmailJS Configuration ────────────────────────────────────────────────────
# Get these from https://www.emailjs.com (free account, 200 emails/month)
#
# Step 1: Sign up at emailjs.com
# Step 2: Add a Service → connect your Gmail (ermias.xii@gmail.com)
# Step 3: Create an Email Template with these variables:
#           {{from_name}}  {{from_email}}  {{subject}}  {{message}}
# Step 4: Copy the IDs below from your EmailJS dashboard

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
